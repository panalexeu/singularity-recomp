diff --git a/include/rex/ui/overlay/achievement_notification.h b/include/rex/ui/overlay/achievement_notification.h
index f9921ed..2d9f6a3 100644
--- a/include/rex/ui/overlay/achievement_notification.h
+++ b/include/rex/ui/overlay/achievement_notification.h
@@ -10,6 +10,8 @@
  */
 #pragma once
 
+#include <functional>
+
 #include <rex/system/achievement_manager.h>
 #include <rex/ui/imgui_dialog.h>
 
@@ -22,8 +24,25 @@ class AchievementNotificationDialog : public ImGuiDialog {
   // Thread-safe implementations may receive events from guest threads.
   virtual void Push(const rex::system::AchievementEvent& event) = 0;
 
+  // True when there is nothing left to show. The app creates the dialog only when a notification
+  // arrives and destroys it once idle: while any ImGui dialog exists, the window is repainted at the
+  // monitor refresh rate instead of only when the guest presents a frame.
+  virtual bool IsIdle() { return false; }
+
+  // Called on the UI thread (from Draw) when the dialog has become idle.
+  void SetOnIdle(std::function<void()> on_idle) { on_idle_ = std::move(on_idle); }
+
  protected:
+  void NotifyIdle() {
+    if (on_idle_) {
+      on_idle_();
+    }
+  }
+
   explicit AchievementNotificationDialog(ImGuiDrawer* drawer) : ImGuiDialog(drawer) {}
+
+ private:
+  std::function<void()> on_idle_;
 };
 
 }  // namespace rex::ui
